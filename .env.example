# Copy to .env and replace the placeholders. Never commit .env.
CLERK_PUBLISHABLE_KEY=pk_test_placeholder
CLERK_SECRET_KEY=sk_test_placeholder
CLERK_JWKS_URL=https://your-clerk-frontend-api.example.com/.well-known/jwks.json
CLERK_ISSUER=https://your-clerk-frontend-api.example.com
# Comma-separated origins allowed in the token's azp claim; leave empty to skip the check.
CLERK_AUTHORIZED_PARTIES=http://localhost:3000
# Comma-separated browser origins allowed to call the API (CORS). Never use *.
CORS_ALLOWED_ORIGINS=http://localhost:3000
DATABASE_URL=postgresql://findipend:findipend@postgres:5432/findipend
VITE_CLERK_PUBLISHABLE_KEY=pk_test_placeholder
VITE_API_BASE_URL=http://localhost:8000
